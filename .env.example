# ─── Supabase ───────────────────────────────────────────────────────────────
# Project URL, e.g. https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Public anon key (safe for the browser; used for read-only inventory listing)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key (SERVER ONLY — bypasses RLS, used for ingestion writes).
# Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Anthropic (normalization agent) ─────────────────────────────────────────
ANTHROPIC_API_KEY=
# Optional override; defaults to claude-haiku-4-5-20251001
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ─── Admin login ─────────────────────────────────────────────────────────────
# Credentials for the sign-in gate. CHANGE THESE in production.
ADMIN_USER=admin
ADMIN_PASSWORD=admin
# Random string used to sign the session cookie. Set a long random value.
SESSION_SECRET=
